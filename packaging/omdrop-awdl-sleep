#!/usr/bin/env bash
# systemd-sleep hook: end any AirDrop window and remove awdl0 before the
# machine sleeps, and create no awdl0 until it has resumed (#67).
#
# On a BCM4387 one s2idle resume in twenty left wlan0 unable to associate
# until a reboot, and it was the only one of the twenty with awdl0 present.
# The reporter's workaround has held since: stop the window, then take awdl0
# down and delete it before suspend. This hook does the same, and also stops
# a create that is starting up or in flight from bringing awdl0 back. That
# can be the boot-time warm-up, awdl0.service, or a window's start.
#
# Every awdl0 is created by awdl-up, under its create lock, and awdl-up
# refuses to create one while $SLEEPING exists. So the order before sleep is:
# write the marker, wait for any create in flight to finish, end the window,
# then remove whatever awdl0 is left, reloading the driver when the firmware
# refuses to remove it. On resume the marker goes, and the next window
# creates awdl0 again.
#
# It runs as root from systemd-sleep, so it doesn't use polkit, and its
# output goes to the journal under systemd-sleep. A failure here must not
# hold up suspend, so every step is best-effort and the hook always exits 0.
set -u

LIB=/usr/lib/omdrop
IF=awdl0
SLEEPING=${AWDL_SLEEP_MARKER:-/run/awdl-up.sleeping}
CREATE_LOCK=${AWDL_CREATE_LOCK:-/run/awdl-up.create.lock}
# awdl-up holds the create lock for at most its 20 s create timeout and 2 s.
CREATE_WAIT=${AWDL_SLEEP_CREATE_WAIT:-25}
SYSMOD=${AWDL_SYSMOD:-/sys/module}
log(){ printf 'omdrop-awdl sleep: %s\n' "$*" >&2; }

case ${1:-} in
  pre) ;;
  post) rm -f "$SLEEPING"; exit 0 ;;
  *) exit 0 ;;
esac

: > "$SLEEPING" || log "could not write $SLEEPING; a create may still bring $IF back"

# Every process with the create lock open: awdl-up and the children that
# inherited its descriptor. Called with descriptor 9 closed, so that the
# subshells running it don't count, and this shell, which holds the lock too,
# is left out by pid.
lock_holders(){
  local fd pid
  for fd in /proc/[0-9]*/fd/*; do
    [[ $(readlink "$fd" 2>/dev/null) == "$CREATE_LOCK" ]] || continue
    pid=${fd#/proc/}; pid=${pid%%/*}
    [[ $pid == "$$" ]] || printf '%s\n' "$pid"
  done | sort -u
}

# Held until exit, so no create can start between here and the destroy.
if exec 9>"$CREATE_LOCK"; then
  if ! flock -w "$CREATE_WAIT" 9; then
    # Scan and kill until the lock is free: a holder can fork a child that
    # inherits the descriptor between one scan and its kill.
    for _ in 1 2 3 4 5; do
      mapfile -t holders < <(lock_holders 9>&-)
      log "a create held its lock for ${CREATE_WAIT}s; killing ${holders[*]:-nothing}"
      (( ${#holders[@]} )) && kill -KILL "${holders[@]}" 2>/dev/null
      flock -w 1 9 && break
    done || log "the create lock is still held"
    # A create the firmware had already accepted registers awdl0 from the
    # driver's event worker, usually within 2 s.
    sleep 2
  fi
else
  log "could not open $CREATE_LOCK"
fi

# Ends this package's window and omdrop-core's: stop signals both supervisors.
if [[ -x $LIB/omdrop-discoverable ]]; then
  "$LIB/omdrop-discoverable" stop || log "omdrop-discoverable stop exited $?"
fi

ip link show "$IF" >/dev/null 2>&1 || exit 0
# Down first, as in the workaround: the netdev's stop path deletes its
# flowrings before the firmware is asked to drop the interface.
ip link set "$IF" down 2>/dev/null || log "could not take $IF down"
if out=$(timeout 8 python3 "$LIB/brcm_iovar.py" -i "$IF" awdl-if destroy 2>&1); then
  # The vendor command only asks the firmware; the interface goes when its
  # IF_DEL event is handled.
  for _ in {1..20}; do
    ip link show "$IF" >/dev/null 2>&1 || { log "removed $IF"; exit 0; }
    sleep 0.1
  done
  log "$IF still present 2 s after the destroy request"
else
  log "destroying $IF failed: ${out##*$'\n'}"
fi

# Once a window has run, BCM4387 firmware refuses interface_remove (BCME
# error, -EBADE) from both the vendor destroy and `iw dev awdl0 del`: AWDL is
# still enabled with the AirDrop template loaded, and turning AWDL off with a
# template loaded has hung the firmware (023513Z). Reloading the driver is
# the one way left to remove awdl0. The Wi-Fi link goes with it, which costs
# nothing here: the machine is about to sleep, and wlan0 reassociates on
# resume. The marker keeps awdl0 from being created again on the way back.
log "reloading brcmfmac to remove $IF"
for mod in brcmfmac_wcc brcmfmac brcmutil; do
  [[ -d $SYSMOD/$mod ]] || continue
  timeout 30 modprobe -r "$mod" || log "modprobe -r $mod failed"
done
timeout 30 modprobe brcmfmac || log "modprobe brcmfmac failed: no Wi-Fi until it is loaded"
if ip link show "$IF" >/dev/null 2>&1; then
  log "$IF is still present after the reload"
else
  log "removed $IF by reloading brcmfmac"
fi
exit 0
