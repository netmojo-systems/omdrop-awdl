#!/usr/bin/env bash
# Radio backend hook `probe --json` (omdrop-core's docs/backend-contract.md),
# Broadcom: what this backend is and what stands in its way, for `omdrop
# doctor` and for core's `start`. Runs without root and changes nothing.
#
# hardware: an Apple Broadcom Wi-Fi chip -- brcmfmac loaded, or a Broadcom
#   (0x14e4) network controller (class 0x0280) on PCI without the driver.
# missing: why discovery cannot work now, the most fundamental first.
#
# A loaded brcmfmac is not necessarily one with AWDL. When the DKMS build
# fails for a new kernel, nothing is installed for it and the kernel's own
# brcmfmac loads instead (issue 51). The marker is a parameter only an AWDL
# brcmfmac has, whether ours or a kernel's own (dkms.conf.in stands aside for
# those): awdl_create_flags, or awdl, the on/off switch that replaced it in
# the series as linux-aurora 7.2 carries it. It is read in sysfs for the
# loaded module, and from modinfo for the one the running kernel would load.
# A loaded switch reading 0 is AWDL turned off, not missing.
#
# module: where AWDL comes from on the running kernel, so Omdrop can describe
#   an update truthfully without guessing from paths or version numbers.
#   "kernel": the kernel's own brcmfmac has AWDL, and dkms.conf.in stands aside
#     for it, so this package supplies only its userspace.
#   "dkms": it does not, so AWDL needs this package's DKMS build.
#   "unknown": that cannot be read (no hardware, no module tree, no modinfo).
#   The test is dkms.conf.in's _awdl_native, so the two always agree.
#
# Exit 0: the JSON object on stdout.
#      2: usage.
set -uo pipefail
# Creates nothing, but every hook starts from a known umask, whatever its
# caller had.
umask 022
# The package version, written in by the PKGBUILD at install. The helper
# contract omdrop-plugin compares (PR #25) is the package version as well.
VERSION=@VERSION@
# Read-only, so it may follow core's test seam: core passes the variable to
# hooks only while it runs unprivileged and honours it itself.
SYS=${OMDROP_RADIO_TEST_ROOT:-}/sys

[[ $# == 1 && $1 == --json ]] || { echo "usage: $0 --json" >&2; exit 2; }

driver=false hardware=false
[[ -d $SYS/module/brcmfmac ]] && driver=true hardware=true
if [[ $hardware == false ]]; then
  for dev in "$SYS"/bus/pci/devices/*; do
    if [[ $(cat "$dev/vendor" 2>/dev/null) == 0x14e4 && $(cat "$dev/class" 2>/dev/null) == 0x0280* ]]; then
      hardware=true
      break
    fi
  done
fi

# Capability and the switch are separate questions. A loaded driver that has
# either marker can do AWDL; the switch, where it exists, then says whether it
# is on (any nonzero integer: the driver reads it as a boolean), off (0), or
# unknown when it cannot be read as an integer. The switch is read even when
# awdl_create_flags is present too, so a known 0 always wins.
loaded_awdl=false switch=none
p=$SYS/module/brcmfmac/parameters
[[ -e $p/awdl_create_flags || -e $p/awdl ]] && loaded_awdl=true
if [[ -e $p/awdl ]]; then
  switch=unknown
  if v=$(cat -- "$p/awdl" 2>/dev/null) && [[ $v =~ ^-?[0-9]+$ ]]; then
    [[ $v =~ ^-?0+$ ]] && switch=off || switch=on
  fi
fi

# The brcmfmac the running kernel would load: yes, no, or unknown when that
# cannot be read. Asked only when it matters: a loaded driver with AWDL is
# ready whatever is on disk, and no hardware needs no verdict. Only a modinfo
# that answered is evidence either way; one that failed says nothing about the
# build. A running kernel whose module tree is gone was upgraded without a
# restart, and the build for the new one is not this kernel's to judge. No
# pipelines, as in dkms.conf.in: grep -q closing a pipe early reads as absent
# under pipefail.
installed=unknown
if [[ $hardware == true && $loaded_awdl == false && -d ${OMDROP_RADIO_TEST_ROOT:-}/lib/modules/$(uname -r) ]] \
   && command -v modinfo >/dev/null 2>&1 && parm=$(modinfo -F parm brcmfmac 2>/dev/null); then
  [[ $'\n'$parm == *$'\n'awdl_create_flags:* || $'\n'$parm == *$'\n'awdl:* ]] && installed=yes || installed=no
fi

# The running kernel's own brcmfmac, as dkms.conf.in's _awdl_native reads it:
# the in-tree module, the copy DKMS archives from it, or a built-in one. A
# kernel that has neither the module nor a built-in entry has no brcmfmac of
# its own, so AWDL can only be ours. Any read that fails leaves it unknown.
module=unknown
kv=$(uname -r)
mods=${OMDROP_RADIO_TEST_ROOT:-}/lib/modules/$kv
if [[ $hardware == true && -d $mods ]] && command -v modinfo >/dev/null 2>&1; then
  module=dkms
  for f in "$mods/kernel/drivers/net/wireless/broadcom/brcm80211/brcmfmac/brcmfmac.ko"* \
           "${OMDROP_RADIO_TEST_ROOT:-}/var/lib/dkms/brcmfmac-awdl/original_module/$kv/"*/brcmfmac.ko*; do
    [[ -f $f && $f != *.origin ]] || continue
    if ! parm=$(modinfo -F parm "$f" 2>/dev/null); then
      module=unknown
      break
    fi
    if [[ $'\n'$parm == *$'\n'awdl_create_flags:* || $'\n'$parm == *$'\n'awdl:* ]]; then
      module=kernel
      break
    fi
  done
  b=$mods/modules.builtin.modinfo
  if [[ $module == dkms && -e $b ]]; then
    if ! p=$(tr '\0' '\n' < "$b" 2>/dev/null); then
      module=unknown
    elif [[ $'\n'$p == *$'\n'brcmfmac.parm=awdl_create_flags:* || $'\n'$p == *$'\n'brcmfmac.parm=awdl:* ]]; then
      module=kernel
    fi
  fi
fi

# Every say is a fixed string: nothing read from the system goes into the JSON.
missing=
if [[ $hardware == false ]]; then
  missing='{"id":"hardware","say":"This computer has no Apple Broadcom Wi-Fi, which this radio backend drives: it runs only on Apple Silicon Macs."}'
elif [[ $switch == off ]]; then
  missing='{"id":"radio","say":"AirDrop is turned off in the Wi-Fi driver (brcmfmac awdl=0). Remove that setting, from /etc/modprobe.d or the kernel command line, and restart."}'
elif [[ $switch == unknown ]]; then
  missing='{"id":"radio","say":"The Wi-Fi driver supports AirDrop, but its awdl setting could not be read, so whether AirDrop is turned on is unknown. Restart, and if this message remains, check the brcmfmac awdl setting."}'
elif [[ $loaded_awdl == true ]]; then
  :
elif [[ $installed == no ]]; then
  missing='{"id":"radio","say":"AirDrop'"'"'s Wi-Fi driver is not built for the running kernel; rebuild it with sudo dkms autoinstall, which also shows why the last build failed."}'
elif [[ $driver == false ]]; then
  missing='{"id":"radio","say":"AirDrop'"'"'s Wi-Fi driver is not loaded. Restart to load it."}'
elif [[ $installed == yes ]]; then
  missing='{"id":"radio","say":"The Wi-Fi driver running now is the kernel'"'"'s own, which cannot do AirDrop. Restart to load AirDrop'"'"'s driver."}'
else
  missing='{"id":"radio","say":"The Wi-Fi driver running now is the kernel'"'"'s own, which cannot do AirDrop; restart, and if this message remains, rebuild AirDrop'"'"'s driver with sudo dkms autoinstall."}'
fi
printf '{"backend":"awdl","version":"%s","contract":"%s","hooks":1,"hardware":%s,"module":"%s","missing":[%s]}\n' \
  "$VERSION" "$VERSION" "$hardware" "$module" "$missing"
