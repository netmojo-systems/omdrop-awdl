# DKMS template for the patched brcmfmac (firmware-native AWDL on BCM4387).
# tools/awdl-dkms-install substitutes @VERSION@ with the source-tree hash and
# stages this next to the sources in /usr/src/brcmfmac-awdl-@VERSION@/.
#
# Modules land in /usr/lib/modules/<kver>/updates/dkms/, and DKMS moves the
# kernel's own brcmutil, brcmfmac and brcmfmac-wcc into
# /var/lib/dkms/brcmfmac-awdl/original_module/<kver>/ while ours is installed,
# putting them back when it is removed. That move happens only on a successful
# install, which is the safety story: if a kernel upgrade breaks the
# out-of-tree build, DKMS installs nothing for that kernel, its own brcmfmac
# loads, and the machine still has Wi-Fi. It loses AWDL, not the network.
#
# CONFIG_BRCMDBG + -DDEBUG build debug.o, which the firmware RAM snapshot
# vendor op (0010) and the debugfs files need. The per-frame `awdl txstatus`
# lines the data-path gate in omdrop-discoverable counts no longer depend on
# them: 0009 prints those through pr_info() while awdl_trace is set.

# Stand aside on a kernel whose own brcmfmac already has AWDL.
#
# The series in 0001-0008 is merged into aurora-silicon/linux, and linux-aurora
# 7.2 carries it. Installing ours on that kernel would swap its driver, and
# every Wi-Fi fix it has that the Asahi tree vendored here lacks, for an older
# one. The marker is a parameter the series adds, which no stock brcmfmac has:
# awdl_create_flags as the series was first merged, or awdl, the on/off switch
# that replaced it (aurora-silicon/linux e75cc82 and d4f767b; linux-aurora
# 7.2.11 has awdl and no awdl_create_flags). It is looked for in the kernel's
# module, in the copy DKMS archived from it, or in modules.builtin.modinfo
# when it is built in.
#
# Two readers source this file: dkms itself, with $kernelver set, and the
# pacman hook's BUILD_EXCLUSIVE_KERNEL check, which sets only $kver. A regex no
# kernel version matches makes both skip that kernel, without an error. On
# every other kernel the variable stays unset and the build runs as before.
# Nothing here may write to stdout, because the hook captures it, and no
# pipelines: grep -q closing a pipe early is a false "absent" under pipefail.
_awdl_native() {
  local kv=$1 f p
  for f in "/lib/modules/$kv/kernel/drivers/net/wireless/broadcom/brcm80211/brcmfmac/brcmfmac.ko"* \
           "${dkms_tree:-/var/lib/dkms}/brcmfmac-awdl/original_module/$kv/"*/brcmfmac.ko*; do
    [[ -f $f && $f != *.origin ]] || continue
    p=$(modinfo -F parm "$f" 2>/dev/null) || continue
    [[ $'\n'$p == *$'\n'awdl_create_flags:* || $'\n'$p == *$'\n'awdl:* ]] && return 0
  done
  f=/lib/modules/$kv/modules.builtin.modinfo
  [[ -r $f ]] || return 1
  p=$(tr '\0' '\n' < "$f" 2>/dev/null) || return 1
  [[ $'\n'$p == *$'\n'brcmfmac.parm=awdl_create_flags:* || $'\n'$p == *$'\n'brcmfmac.parm=awdl:* ]]
}
_awdl_kv=${kernelver:-${kver:-}}
if [[ -n $_awdl_kv ]] && _awdl_native "$_awdl_kv"; then
  BUILD_EXCLUSIVE_KERNEL='^$'
fi

PACKAGE_NAME="brcmfmac-awdl"
PACKAGE_VERSION="@VERSION@"
AUTOINSTALL="yes"

MAKE[0]="make -C /lib/modules/${kernelver}/build M=${dkms_tree}/${PACKAGE_NAME}/${PACKAGE_VERSION}/build \
  CONFIG_BRCMFMAC=m CONFIG_BRCMFMAC_PCIE=y CONFIG_BRCMFMAC_USB=y CONFIG_BRCMUTIL=m \
  CONFIG_BRCMFMAC_PROTO_MSGBUF=y CONFIG_BRCMFMAC_PROTO_BCDC=y CONFIG_BRCMDBG=y \
  KCFLAGS='-DDEBUG -DCONFIG_BRCMDBG' modules"
CLEAN="make -C /lib/modules/${kernelver}/build M=${dkms_tree}/${PACKAGE_NAME}/${PACKAGE_VERSION}/build clean"

BUILT_MODULE_NAME[0]="brcmutil"
BUILT_MODULE_LOCATION[0]="brcmutil"
DEST_MODULE_LOCATION[0]="/updates/dkms"

BUILT_MODULE_NAME[1]="brcmfmac"
BUILT_MODULE_LOCATION[1]="brcmfmac"
DEST_MODULE_LOCATION[1]="/updates/dkms"

BUILT_MODULE_NAME[2]="brcmfmac-wcc"
BUILT_MODULE_LOCATION[2]="brcmfmac/wcc"
DEST_MODULE_LOCATION[2]="/updates/dkms"
